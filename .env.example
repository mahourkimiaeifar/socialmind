# --- Django ---
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- مدل زبانی (فقط سمت سرور) ---
# کلید را فقط در فایل .env واقعی قرار دهید. این فایل نمونه است و نباید کلید واقعی داشته باشد.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_STYLE=responses
OPENAI_TIMEOUT=90

# --- جزوه‌ها و بازیابی روشی ---
# مسیر پوشهٔ PDFها؛ دستور import_handouts بدون آرگومان از همین استفاده می‌کند.
HANDOUTS_DIR=C:\Users\iman\Documents\جزوه ها
# در هر نوبت گفتگو جزوه‌ها بررسی شوند تا سؤال تکمیلی هدفمند انتخاب شود.
HANDOUT_RETRIEVAL_PER_TURN=True
# حداکثر بخش‌های بررسی‌شده در هر نوبت.
HANDOUT_TURN_SOURCES=5

# --- محدودیت‌های دلخواه (اختیاری) ---
# MESSAGE_MAX_LENGTH=1500
# MAX_USER_MESSAGES_PER_CONVERSATION=40
# MAX_MESSAGES_PER_CONVERSATION=100
